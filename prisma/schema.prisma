generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    WorkspaceMember[]
  projects   Project[]
  activities Activity[]
  labels     Label[]
  savedTaskViews SavedTaskView[]
}

model User {
  id                 String            @id
  name               String
  email              String            @unique
  initials           String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  memberships        WorkspaceMember[]
  projectMemberships ProjectMember[]
  assignedTasks      Task[]            @relation("TaskAssignee")
  activities         Activity[]
  taskComments       TaskComment[]
  savedTaskViews     SavedTaskView[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("Member")
  status      String    @default("Active")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Project {
  id             String          @id
  workspaceId    String
  name           String
  description    String
  status         String          @default("Draft")
  progress       Int             @default(0)
  completedTasks Int             @default(0)
  totalTasks     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]
  milestones     Milestone[]
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id            String           @id
  projectId     String
  assigneeId    String?
  milestoneId   String?
  title         String
  priority      String           @default("Medium")
  status        String           @default("Todo")
  dueDate       DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  milestone     Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  subtasks      TaskSubtask[]
  dependencies  TaskDependency[] @relation("DependentTask")
  blockingTasks TaskDependency[] @relation("PrerequisiteTask")
  labels        TaskLabel[]

  @@index([milestoneId])
}

model Label {
  id          String      @id
  workspaceId String
  name        String
  color       String      @default("slate")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Milestone {
  id          String   @id
  projectId   String
  title       String
  description String   @default("")
  status      String   @default("Open")
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, status, dueDate])
}

model TaskSubtask {
  id        String   @id
  taskId    String
  title     String
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())
  task            Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task     @relation("PrerequisiteTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

model TaskComment {
  id        String   @id
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model SavedTaskView {
  id          String    @id
  workspaceId String
  userId      String
  name        String
  query       String    @default("")
  projectId   String?
  priority    String?
  status      String?
  labelId     String?
  milestoneId String?
  due         String    @default("all")
  sort        String    @default("due-asc")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId, updatedAt])
}

model Activity {
  id          String    @id
  workspaceId String
  userId      String?
  message     String
  occurredAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}
